# Copy this to .env and fill in. Never commit .env.

# ── LLM gateway ─────────────────────────────────────────────────────
# LiteLLM forwards calls to Anthropic with this key. Get one at
# https://console.anthropic.com/ → API keys.
ANTHROPIC_API_KEY=sk-ant-...

# ── Slack approval surface (needed in Step 4; ignored before that) ──
# Bot token, xoxb-... form. Scopes needed:
#   chat:write          post draft messages
#   reactions:read      poll user reactions for 👍 / 👎
#   reactions:write     seed the message with starter reactions
SLACK_BOT_TOKEN=xoxb-...

# Channel ID (the C0... form, NOT the channel name). Find it in
# Slack: right-click channel → View channel details → copy at bottom.
SLACK_APPROVAL_CHANNEL=C0...

# ── Engineering agent: web search (Exa) ─────────────────────────────
# The agent's ONE outbound capability. Egress restricted to api.exa.ai.
# Get a key at https://exa.ai. Until set, web_search reports itself as
# not-configured rather than guessing.
EXA_API_KEY=

# ── Engineering agent: Google Drive ─────────────────────────────────
# The agent reads engineering/ docs and creates drafts in
# engineering/drafts/ via a service account. Steps:
#   1. Google Cloud Console → new/existing project → enable Drive API.
#   2. Create a service account, download its JSON key, save it at the
#      repo root as service-account.json (gitignored). Then uncomment
#      the bind mount in docker-compose.yml's agent service.
#   3. In Drive, create engineering/{specs,sows,design-docs,testing,
#      certifications,templates,drafts}/. Share Viewer on engineering/
#      and Editor on engineering/drafts/ with the service-account email.
#   4. Put the folder ids below (from each folder's URL).
ORRERY_ENG_DRIVE_FOLDER_ID=
ORRERY_ENG_DRAFTS_FOLDER_ID=

# ── Web backend ─────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be set to a strong random value (the dev default is insecure).
ORRERY_SESSION_SECRET=
# Postgres connection used by the backend. The default matches the
# `postgres` service in docker-compose; override for an external DB.
# ORRERY_DATABASE_URL=postgresql+psycopg://orrery:orrery@postgres:5432/orrery
