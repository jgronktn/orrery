# Copy this to .env and fill in. Never commit .env.

# ── LLM gateway ─────────────────────────────────────────────────────
# LiteLLM forwards calls to Anthropic with this key. Get one at
# https://console.anthropic.com/ → API keys.
ANTHROPIC_API_KEY=sk-ant-...

# ── Slack approval surface (needed in Step 4; ignored before that) ──
# Bot token, xoxb-... form. Scopes needed:
#   chat:write          post draft messages
#   reactions:read      poll user reactions for 👍 / 👎
#   reactions:write     seed the message with starter reactions
SLACK_BOT_TOKEN=xoxb-...

# Channel ID (the C0... form, NOT the channel name). Find it in
# Slack: right-click channel → View channel details → copy at bottom.
SLACK_APPROVAL_CHANNEL=C0...

# ── Engineering agent: web search (Exa) ─────────────────────────────
# The agent's ONE outbound capability. Egress restricted to api.exa.ai.
# Get a key at https://exa.ai. Until set, web_search reports itself as
# not-configured rather than guessing.
EXA_API_KEY=

# ── Observability (Pydantic Logfire) ────────────────────────────────
# Agent + app tracing (loops, tokens, cost, tool calls, latency) via Logfire
# (OpenTelemetry under the hood). Instrumentation is always wired but INERT
# until a token is set (send_to_logfire="if-token-present") — leave blank for
# local dev with no telemetry. Create a project at https://logfire.pydantic.dev
# and paste its write token to start sending. Scrubbing is on by default.
LOGFIRE_TOKEN=

# ── Engineering agent: document store (filesystem) ──────────────────
# The agent reads and writes documents under this root (specs, templates,
# drafts, ...). Defaults to /var/lib/orrery/files; override on dev if you
# keep the tree elsewhere. All file paths in code derive from this.
# ORRERY_FILES_ROOT=/var/lib/orrery/files

# ── Google service account (Drive) ──────────────────────────────────
# NO LONGER used for document storage (that moved to the filesystem).
# The service account key (repo-root service-account.json) is kept for
# the upcoming Gmail/email integration. These folder-id vars are unused
# now; left blank, harmless.
ORRERY_ENG_DRIVE_FOLDER_ID=
ORRERY_ENG_DRAFTS_FOLDER_ID=

# ── Web backend ─────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be set to a strong random value (the dev default is insecure).
ORRERY_SESSION_SECRET=
# Postgres connection used by the backend. The default matches the
# `postgres` service in docker-compose; override for an external DB.
# ORRERY_DATABASE_URL=postgresql+psycopg://orrery:orrery@postgres:5432/orrery

# ── Production only (docker-compose.prod.yml) ───────────────────────
# These are consumed by docker-compose.prod.yml; ignored by the dev stack.
# See docs/deploy.md.
#
# Postgres password for the in-compose DB (prod compose builds the
# DATABASE_URL from it). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# POSTGRES_PASSWORD=
# The UID:GID the containers run as (the orrery system user). Set from
#   id -u orrery   /   id -g orrery
# ORRERY_UID=1001
# ORRERY_GID=1001
#
# The public origin(s) the browser app is served from — REQUIRED by the prod
# compose (it has no default; `up` fails until this is set). JSON array form:
# ORRERY_CORS_ORIGINS=["https://your-domain"]
#
# The prod compose already hardcodes these, but they can be overridden here:
#   ORRERY_ENV=prod
#   ORRERY_COOKIE_SECURE=true            (Secure cookies behind HTTPS)
